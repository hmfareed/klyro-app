// Klyro — Canonical Prisma Schema (First Architecture 02 + 03 + 21 + 22 + 24).
// Single source of truth across all platform phases.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum ProjectStatus {
  RECRUITING
  IN_PROGRESS
  PAUSED
  COMPLETED
  ARCHIVED
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum PermissionLevel {
  OWNER
  MAINTAINER
  CONTRIBUTOR
  VIEWER
}

enum MemberStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  DONE
  MISSED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// 30-onboarding: entry branch + intent + resumable progress (server-persisted).
enum OnboardingEntryPoint {
  ORGANIC
  PROJECT_INVITE
  GROUP_INVITE
  OAUTH
  REFERRAL
}

enum OnboardingIntent {
  START
  JOIN
  BOTH
}

// 21-legal: IP model selected at project creation, shown to applicants.
enum IpModel {
  OWNER_RETAINED
  OPEN_SOURCE
  SHARED_EQUITY
  PORTFOLIO_ONLY
}

// 22-admin: platform-level roles, distinct from project PermissionLevel.
enum PlatformAdminRole {
  SUPER_ADMIN
  TRUST_SAFETY
  SUPPORT
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  emailVerifiedAt DateTime?
  username        String      @unique
  passwordHash    String?
  displayName     String?
  avatarUrl       String?
  bio             String?     @db.VarChar(160)
  about           String?     @db.Text
  location        String?
  websiteUrl      String?
  githubUsername  String?
  isVerifiedEmail Boolean     @default(false)
  status          UserStatus  @default(ACTIVE)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // 30 §6: resumable onboarding — valid permanent state is "activated but sparse".
  onboardingEntryPoint  OnboardingEntryPoint?
  onboardingIntent      OnboardingIntent?
  onboardingStep        Int                 @default(3) // 3=username … 7=intent, 8=done
  onboardingCompletedAt DateTime?
  // 21 §4: ToS acceptance (minimal ToS required from first real project).
  acceptedTermsAt       DateTime?
  // 29 §4: lightweight community affiliation (school/bootcamp/club, self-reported).
  community             String?

  oauthAccounts       OAuthAccount[]
  sessions            Session[]
  skills              SkillOnUser[]
  projectsOwned       Project[]            @relation("ProjectOwner")
  memberships         TeamMember[]
  applications        Application[]
  assignedTasks       TaskAssignee[]
  discussionThreads   DiscussionThread[]
  discussionComments  DiscussionComment[]
  uploadedFiles       FileAsset[]
  contributionRecords ContributionRecord[]
  notifications       Notification[]
  usernameHistory     UsernameHistory[]
  platformAdmin       PlatformAdmin?
  activityEvents      ActivityEvent[]
  followedProjects    ProjectFollower[]
  starredProjects     ProjectStar[]
  releasesAuthored    Release[]
  projectUpdates      ProjectUpdate[]
  repositoriesOwned       Repository[]          @relation("RepositoryOwner")
  repositoryStars         RepositoryStar[]
  repositoryWatchers      RepositoryWatcher[]
  repositoryCollaborators RepositoryCollaborator[]
  repositoryIssues        RepositoryIssue[]     @relation("IssueAuthor")
  assignedRepositoryIssues RepositoryIssue[]    @relation("IssueAssignee")
  repositoryIssueComments RepositoryIssueComment[]
  pullRequestsAuthored    PullRequest[]         @relation("PRAuthor")
  pullRequestsMerged      PullRequest[]         @relation("PRMergedBy")
  pullRequestReviews      PullRequestReview[]
  pullRequestComments     PullRequestComment[]  @relation("PRCommentAuthor")
  resolvedPrComments      PullRequestComment[]  @relation("PRCommentResolvedBy")
  repositoryReleases      RepositoryRelease[]
  repositoryAuditEvents   RepositoryAuditEvent[]
  personalAccessTokens    PersonalAccessToken[]
  sshKeys                 UserSshKey[]

  @@index([username])
}

model UsernameHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username  String
  createdAt DateTime @default(now())

  @@index([username])
  @@index([userId])
}

model OAuthAccount {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String   // github | google
  providerUserId String
  accessToken    String   @db.Text // encrypted at app layer (KMS envelope per 12)
  refreshToken   String?  @db.Text
  scope          String?

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // sha256 of opaque token; token itself never stored
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Skill {
  id       String        @id @default(cuid())
  name     String        @unique
  category String        // engineering | design | writing | product | marketing
  users    SkillOnUser[]
}

model SkillOnUser {
  userId  String
  skillId String
  level   SkillLevel @default(INTERMEDIATE)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

model Project {
  id                String             @id @default(cuid())
  ownerId           String
  owner             User               @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  slug              String             @unique
  title             String
  tagline           String             @db.VarChar(160)
  description       String             @db.Text
  category          String
  status            ProjectStatus      @default(RECRUITING)
  visibility        Visibility         @default(PUBLIC)
  coverImageUrl     String?
  techStack         String[]
  commitmentLevel   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  completedAt       DateTime?

  // 21 §2: required at creation, shown on public page next to open roles.
  ipModel           IpModel            @default(PORTFOLIO_ONLY)
  openSourceLicense String?            // MIT | Apache-2.0 | GPL-3.0 — never free-text (21 §2)
  ipSummary         String?            @db.VarChar(280)

  roles               Role[]
  members             TeamMember[]
  applications        Application[]
  milestones          Milestone[]
  tasks               Task[]
  threads             DiscussionThread[]
  files               FileAsset[]
  contributionRecords ContributionRecord[]
  activityEvents      ActivityEvent[]
  followers           ProjectFollower[]
  stars               ProjectStar[]
  releases            Release[]
  updates             ProjectUpdate[]
  repositories        Repository[]

  @@index([ownerId])
  @@index([status, visibility])
}

model Role {
  id              String          @id @default(cuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?         @db.Text
  isOpen          Boolean         @default(true)
  permissionLevel PermissionLevel @default(CONTRIBUTOR)
  members         TeamMember[]
  applications    Application[]

  @@index([projectId])
}

model TeamMember {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status    MemberStatus @default(ACTIVE)
  joinedAt  DateTime     @default(now())
  leftAt    DateTime?

  @@unique([projectId, userId])
  @@index([userId])
}

model Application {
  id          String            @id @default(cuid())
  projectId   String
  roleId      String
  applicantId String
  message     String            @db.Text
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  decidedAt   DateTime?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  applicant User    @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([applicantId])
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  title       String
  description String?         @db.Text
  dueDate     DateTime?
  status      MilestoneStatus @default(PLANNED)
  order       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks               Task[]
  contributionRecords ContributionRecord[]

  @@index([projectId])
}

model Task {
  id          String     @id @default(cuid())
  projectId   String
  milestoneId String?
  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  completedAt DateTime?

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone?     @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignees TaskAssignee[]

  @@index([projectId, status])
  @@index([milestoneId])
}

model TaskAssignee {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model DiscussionThread {
  id        String              @id @default(cuid())
  projectId String
  title     String
  body      String              @db.Text
  authorId  String
  isPinned  Boolean             @default(false)
  isLocked  Boolean             @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  project  Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author   User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments DiscussionComment[]

  @@index([projectId, createdAt])
  @@index([authorId])
}

model DiscussionComment {
  id        String           @id @default(cuid())
  threadId  String
  authorId  String
  body      String           @db.Text
  createdAt DateTime         @default(now())
  editedAt  DateTime?

  thread DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User             @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([authorId])
}

model FileAsset {
  id           String   @id @default(cuid())
  projectId    String
  uploadedById String
  fileName     String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  version      Int      @default(1)
  parentFileId String?
  createdAt    DateTime @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ContributionRecord {
  id               String     @id @default(cuid())
  userId           String
  projectId        String
  milestoneId      String?
  summary          String     @db.Text
  roleTitle        String
  tasksCompleted   Int        @default(0)
  commitsAuthored  Int        @default(0)
  peerAttestations Json       @default("[]") // [{ fromUserId, fromName, statement, rating }]
  issuedAt         DateTime   @default(now())
  recordHash       String     @unique
  isFinal          Boolean    @default(false)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // APPLICATION_RECEIVED, APPLICATION_DECIDED, TASK_ASSIGNED, DISCUSSION_REPLY, RECORD_ISSUED
  title     String
  body      String
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

// 22-admin: small explicit table — never conflated with project PermissionLevel.
model PlatformAdmin {
  id        String            @id @default(cuid())
  userId    String            @unique
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      PlatformAdminRole
  createdAt DateTime          @default(now())

  @@index([role])
}

// 24-analytics: server-side business-action events (ad-blocker-proof).
model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String
  userId    String?
  projectId String?
  props     Json?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId])
}

enum ActivityEventType {
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_PUBLISHED
  PROJECT_STARRED
  PROJECT_FOLLOWED
  MEMBER_JOINED
  MEMBER_LEFT
  COLLABORATOR_INVITED
  COLLABORATOR_ACCEPTED
  TASK_CREATED
  TASK_COMPLETED
  MILESTONE_CREATED
  MILESTONE_COMPLETED
  ISSUE_CREATED
  ISSUE_RESOLVED
  PULL_REQUEST_OPENED
  PULL_REQUEST_MERGED
  RELEASE_CREATED
  DISCUSSION_CREATED
  DISCUSSION_REPLIED
  REPOSITORY_CREATED
  REPOSITORY_UPDATED
  PROJECT_RECRUITING
  PROJECT_RECRUITING_CLOSED
  CONTRIBUTOR_ADDED
  BUILD_LAUNCHED
  POST_UPDATE
}

model ActivityEvent {
  id         String            @id @default(cuid())
  actorId    String
  projectId  String
  type       ActivityEventType
  targetType String?
  targetId   String?
  metadata   Json?
  visibility Visibility        @default(PUBLIC)
  createdAt  DateTime          @default(now())
  expiresAt  DateTime?

  actor   User    @relation(fields: [actorId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([projectId, createdAt])
  @@index([actorId, createdAt])
  @@index([visibility, createdAt])
}

model ProjectFollower {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model ProjectStar {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model Release {
  id           String   @id @default(cuid())
  projectId    String
  version      String
  title        String
  description  String?  @db.Text
  releaseNotes String?  @db.Text
  createdById  String
  createdAt    DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ProjectUpdate {
  id        String   @id @default(cuid())
  projectId String
  authorId  String
  title     String
  body      String   @db.Text
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

// ==========================================
// KLYRO REPOSITORY SYSTEM (Repo Architecture)
// ==========================================

model Repository {
  id              String                  @id @default(cuid())
  workspaceId     String?
  projectId       String?
  ownerId         String
  name            String
  slug            String
  description     String?                 @db.Text
  visibility      Visibility              @default(PUBLIC)
  defaultBranch   String                  @default("main")
  gitStoragePath  String
  archived        Boolean                 @default(false)
  archivedAt      DateTime?
  disabled        Boolean                 @default(false)
  status          String                  @default("ACTIVE") // ACTIVE, ARCHIVED, DELETION_PENDING, PURGING, DELETED
  deletedAt       DateTime?
  deletionScheduledAt DateTime?
  purgeAt         DateTime?
  restoredAt      DateTime?
  forkedFromId    String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  owner           User                    @relation("RepositoryOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  project         Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  forkedFrom      Repository?             @relation("RepositoryForks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks           Repository[]            @relation("RepositoryForks")

  stars           RepositoryStar[]
  watchers        RepositoryWatcher[]
  collaborators   RepositoryCollaborator[]
  branchRules     BranchProtectionRule[]
  issues          RepositoryIssue[]
  pullRequests    PullRequest[]
  releases        RepositoryRelease[]
  webhooks        RepositoryWebhook[]
  actionRuns      RepositoryActionRun[]
  auditEvents     RepositoryAuditEvent[]

  @@unique([ownerId, slug])
  @@index([slug])
  @@index([projectId])
  @@index([ownerId])
  @@index([visibility])
  @@index([status])
}

model RepositoryStar {
  id           String     @id @default(cuid())
  userId       String
  repositoryId String
  createdAt    DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId])
  @@index([userId])
  @@index([repositoryId])
}

model RepositoryWatcher {
  id           String     @id @default(cuid())
  userId       String
  repositoryId String
  level        String     @default("ALL") // ALL, PARTICIPATING, IGNORE
  createdAt    DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId])
  @@index([userId])
  @@index([repositoryId])
}

model RepositoryCollaborator {
  id           String          @id @default(cuid())
  repositoryId String
  userId       String
  role         PermissionLevel @default(CONTRIBUTOR)
  createdAt    DateTime        @default(now())

  repository   Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, userId])
  @@index([repositoryId])
  @@index([userId])
}

model BranchProtectionRule {
  id                 String     @id @default(cuid())
  repositoryId       String
  pattern            String     @default("main")
  requirePullRequest Boolean    @default(true)
  requiredApprovals  Int        @default(1)
  preventForcePush   Boolean    @default(true)
  preventDeletion    Boolean    @default(true)
  createdAt          DateTime   @default(now())

  repository         Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
}

model RepositoryIssue {
  id           String                   @id @default(cuid())
  repositoryId String
  number       Int
  title        String
  body         String                   @db.Text
  status       String                   @default("OPEN") // OPEN, CLOSED
  authorId     String
  assigneeId   String?
  labels       String[]                 @default([])
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  closedAt     DateTime?

  repository   Repository               @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  author       User                     @relation("IssueAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  assignee     User?                    @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments     RepositoryIssueComment[]

  @@unique([repositoryId, number])
  @@index([repositoryId, status])
  @@index([authorId])
  @@index([assigneeId])
}

model RepositoryIssueComment {
  id        String          @id @default(cuid())
  issueId   String
  authorId  String
  body      String          @db.Text
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  issue     RepositoryIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    User            @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
  @@index([authorId])
}

model PullRequest {
  id           String               @id @default(cuid())
  repositoryId String
  number       Int
  title        String
  body         String               @db.Text
  status       String               @default("OPEN") // OPEN, MERGED, CLOSED
  baseBranch   String               @default("main")
  headBranch   String
  authorId     String
  mergedById   String?
  mergedAt     DateTime?
  closedAt     DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  repository   Repository           @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  author       User                 @relation("PRAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  mergedBy     User?                @relation("PRMergedBy", fields: [mergedById], references: [id], onDelete: SetNull)
  reviews      PullRequestReview[]
  comments     PullRequestComment[]

  @@unique([repositoryId, number])
  @@index([repositoryId, status])
  @@index([authorId])
}

model PullRequestReview {
  id            String      @id @default(cuid())
  pullRequestId String
  reviewerId    String
  state         String      // APPROVED, CHANGES_REQUESTED, COMMENTED
  body          String?     @db.Text
  createdAt     DateTime    @default(now())

  pullRequest   PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  reviewer      User        @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([pullRequestId])
  @@index([reviewerId])
}

model PullRequestComment {
  id            String              @id @default(cuid())
  pullRequestId String
  authorId      String
  body          String              @db.Text
  diffPath      String?
  diffLine      Int?
  side          String?             @default("RIGHT") // LEFT, RIGHT
  commitId      String?
  parentId      String?
  resolvedAt    DateTime?
  resolvedById  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  pullRequest   PullRequest         @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  author        User                @relation("PRCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent        PullRequestComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       PullRequestComment[] @relation("CommentReplies")
  resolvedBy    User?               @relation("PRCommentResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([pullRequestId, createdAt])
  @@index([authorId])
  @@index([parentId])
  @@index([diffPath, diffLine])
}

model RepositoryRelease {
  id               String     @id @default(cuid())
  repositoryId     String
  tagName          String
  targetCommitish  String     @default("main")
  name             String
  body             String?    @db.Text
  isDraft          Boolean    @default(false)
  isPrerelease     Boolean    @default(false)
  authorId         String
  publishedAt      DateTime   @default(now())
  createdAt        DateTime   @default(now())

  repository       Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  author           User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, tagName])
  @@index([repositoryId])
  @@index([authorId])
}

model RepositoryWebhook {
  id           String                      @id @default(cuid())
  repositoryId String
  url          String
  secret       String?
  events       String[]                    @default(["push", "pull_request", "issues", "release"])
  active       Boolean                     @default(true)
  createdAt    DateTime                    @default(now())

  repository   Repository                  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  deliveries   RepositoryWebhookDelivery[]

  @@index([repositoryId])
}

model RepositoryWebhookDelivery {
  id           String            @id @default(cuid())
  webhookId    String
  event        String
  payload      Json
  statusCode   Int?
  responseBody String?           @db.Text
  durationMs   Int?
  error        String?
  createdAt    DateTime          @default(now())

  webhook      RepositoryWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
}

model RepositoryActionRun {
  id           String     @id @default(cuid())
  repositoryId String
  workflowName String
  commitSha    String
  branch       String
  event        String
  status       String     @default("SUCCESS") // QUEUED, RUNNING, SUCCESS, FAILURE, CANCELLED
  logs         String?    @db.Text
  durationMs   Int        @default(0)
  startedAt    DateTime   @default(now())
  completedAt  DateTime?
  createdAt    DateTime   @default(now())

  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, createdAt])
}

model RepositoryAuditEvent {
  id            String     @id @default(cuid())
  repositoryId  String
  actorId       String
  action        String     // REPOSITORY_VISIBILITY_CHANGED, REPOSITORY_ARCHIVED, REPOSITORY_UNARCHIVED, REPOSITORY_DELETION_SCHEDULED, REPOSITORY_RESTORED, REPOSITORY_PURGED
  previousValue String?
  newValue      String?
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime   @default(now())

  repository    Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  actor         User       @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([repositoryId, createdAt])
  @@index([actorId, createdAt])
}

model PersonalAccessToken {
  id          String    @id @default(cuid())
  userId      String
  name        String
  tokenPrefix String    // e.g. "klyro_pat_abcd..."
  tokenHash   String    @unique // SHA-256 hash of the full token
  scopes      String[]  @default(["repo:read", "repo:write"])
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model UserSshKey {
  id          String    @id @default(cuid())
  userId      String
  title       String
  publicKey   String    @db.Text
  fingerprint String    @unique // SHA256:<base64-fingerprint>
  keyType     String    // e.g. ssh-ed25519, ssh-rsa, ecdsa-sha2-nistp256
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fingerprint])
}


