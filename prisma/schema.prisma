// Klyro — Canonical Prisma Schema (First Architecture 02 + 03 + 21 + 22 + 24).
// Single source of truth across all platform phases.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum ProjectStatus {
  RECRUITING
  IN_PROGRESS
  PAUSED
  COMPLETED
  ARCHIVED
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum PermissionLevel {
  OWNER
  MAINTAINER
  CONTRIBUTOR
  VIEWER
}

enum MemberStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  DONE
  MISSED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// 30-onboarding: entry branch + intent + resumable progress (server-persisted).
enum OnboardingEntryPoint {
  ORGANIC
  PROJECT_INVITE
  GROUP_INVITE
  OAUTH
  REFERRAL
}

enum OnboardingIntent {
  START
  JOIN
  BOTH
}

// 21-legal: IP model selected at project creation, shown to applicants.
enum IpModel {
  OWNER_RETAINED
  OPEN_SOURCE
  SHARED_EQUITY
  PORTFOLIO_ONLY
}

// 22-admin: platform-level roles, distinct from project PermissionLevel.
enum PlatformAdminRole {
  SUPER_ADMIN
  TRUST_SAFETY
  SUPPORT
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  emailVerifiedAt DateTime?
  username        String      @unique
  passwordHash    String?
  displayName     String?
  avatarUrl       String?
  bio             String?     @db.VarChar(160)
  about           String?     @db.Text
  location        String?
  websiteUrl      String?
  githubUsername  String?
  isVerifiedEmail Boolean     @default(false)
  status          UserStatus  @default(ACTIVE)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // 30 §6: resumable onboarding — valid permanent state is "activated but sparse".
  onboardingEntryPoint  OnboardingEntryPoint?
  onboardingIntent      OnboardingIntent?
  onboardingStep        Int                 @default(3) // 3=username … 7=intent, 8=done
  onboardingCompletedAt DateTime?
  // 21 §4: ToS acceptance (minimal ToS required from first real project).
  acceptedTermsAt       DateTime?
  // 29 §4: lightweight community affiliation (school/bootcamp/club, self-reported).
  community             String?

  oauthAccounts       OAuthAccount[]
  sessions            Session[]
  skills              SkillOnUser[]
  projectsOwned       Project[]            @relation("ProjectOwner")
  memberships         TeamMember[]
  applications        Application[]
  assignedTasks       TaskAssignee[]
  discussionThreads   DiscussionThread[]
  discussionComments  DiscussionComment[]
  uploadedFiles       FileAsset[]
  contributionRecords ContributionRecord[]
  notifications       Notification[]
  usernameHistory     UsernameHistory[]
  platformAdmin       PlatformAdmin?

  @@index([username])
}

model UsernameHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username  String
  createdAt DateTime @default(now())

  @@index([username])
  @@index([userId])
}

model OAuthAccount {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String   // github | google
  providerUserId String
  accessToken    String   @db.Text // encrypted at app layer (KMS envelope per 12)
  refreshToken   String?  @db.Text
  scope          String?

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // sha256 of opaque token; token itself never stored
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Skill {
  id       String        @id @default(cuid())
  name     String        @unique
  category String        // engineering | design | writing | product | marketing
  users    SkillOnUser[]
}

model SkillOnUser {
  userId  String
  skillId String
  level   SkillLevel @default(INTERMEDIATE)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

model Project {
  id                String             @id @default(cuid())
  ownerId           String
  owner             User               @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  slug              String             @unique
  title             String
  tagline           String             @db.VarChar(160)
  description       String             @db.Text
  category          String
  status            ProjectStatus      @default(RECRUITING)
  visibility        Visibility         @default(PUBLIC)
  coverImageUrl     String?
  techStack         String[]
  commitmentLevel   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  completedAt       DateTime?

  // 21 §2: required at creation, shown on public page next to open roles.
  ipModel           IpModel            @default(PORTFOLIO_ONLY)
  openSourceLicense String?            // MIT | Apache-2.0 | GPL-3.0 — never free-text (21 §2)
  ipSummary         String?            @db.VarChar(280)

  roles               Role[]
  members             TeamMember[]
  applications        Application[]
  milestones          Milestone[]
  tasks               Task[]
  threads             DiscussionThread[]
  files               FileAsset[]
  contributionRecords ContributionRecord[]

  @@index([ownerId])
  @@index([status, visibility])
}

model Role {
  id              String          @id @default(cuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?         @db.Text
  isOpen          Boolean         @default(true)
  permissionLevel PermissionLevel @default(CONTRIBUTOR)
  members         TeamMember[]
  applications    Application[]

  @@index([projectId])
}

model TeamMember {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status    MemberStatus @default(ACTIVE)
  joinedAt  DateTime     @default(now())
  leftAt    DateTime?

  @@unique([projectId, userId])
  @@index([userId])
}

model Application {
  id          String            @id @default(cuid())
  projectId   String
  roleId      String
  applicantId String
  message     String            @db.Text
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  decidedAt   DateTime?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  applicant User    @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([applicantId])
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  title       String
  description String?         @db.Text
  dueDate     DateTime?
  status      MilestoneStatus @default(PLANNED)
  order       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks               Task[]
  contributionRecords ContributionRecord[]

  @@index([projectId])
}

model Task {
  id          String     @id @default(cuid())
  projectId   String
  milestoneId String?
  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  completedAt DateTime?

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone?     @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignees TaskAssignee[]

  @@index([projectId, status])
  @@index([milestoneId])
}

model TaskAssignee {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model DiscussionThread {
  id        String              @id @default(cuid())
  projectId String
  title     String
  body      String              @db.Text
  authorId  String
  isPinned  Boolean             @default(false)
  isLocked  Boolean             @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  project  Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author   User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments DiscussionComment[]

  @@index([projectId, createdAt])
  @@index([authorId])
}

model DiscussionComment {
  id        String           @id @default(cuid())
  threadId  String
  authorId  String
  body      String           @db.Text
  createdAt DateTime         @default(now())
  editedAt  DateTime?

  thread DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User             @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([authorId])
}

model FileAsset {
  id           String   @id @default(cuid())
  projectId    String
  uploadedById String
  fileName     String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  version      Int      @default(1)
  parentFileId String?
  createdAt    DateTime @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ContributionRecord {
  id               String     @id @default(cuid())
  userId           String
  projectId        String
  milestoneId      String?
  summary          String     @db.Text
  roleTitle        String
  tasksCompleted   Int        @default(0)
  commitsAuthored  Int        @default(0)
  peerAttestations Json       @default("[]") // [{ fromUserId, fromName, statement, rating }]
  issuedAt         DateTime   @default(now())
  recordHash       String     @unique
  isFinal          Boolean    @default(false)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // APPLICATION_RECEIVED, APPLICATION_DECIDED, TASK_ASSIGNED, DISCUSSION_REPLY, RECORD_ISSUED
  title     String
  body      String
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

// 22-admin: small explicit table — never conflated with project PermissionLevel.
model PlatformAdmin {
  id        String            @id @default(cuid())
  userId    String            @unique
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      PlatformAdminRole
  createdAt DateTime          @default(now())

  @@index([role])
}

// 24-analytics: server-side business-action events (ad-blocker-proof).
model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String
  userId    String?
  projectId String?
  props     Json?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId])
}
